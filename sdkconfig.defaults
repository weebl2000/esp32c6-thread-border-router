# =============================================================================
# sdkconfig.defaults — ot_br on XIAO ESP32-C6 (4 MB flash, USB power only)
# Re-based for ESP-IDF v5.5.x.
#
# Usage:
#   APPEND this file's contents to the BOTTOM of
#     $IDF_PATH/examples/openthread/ot_br/sdkconfig.defaults
#   (do not replace it — the example's own defaults must stay; ours override
#   them because they come last). Then copy partitions_4mb_otbr.csv and
#   main/{esp_ot_br.c,CMakeLists.txt} into the example, set your Wi-Fi creds, and:
#     idf.py set-target esp32c6
#     idf.py build flash monitor
# =============================================================================

# -----------------------------------------------------------------------------
# Flash & partition table (override the example's 1900K partitions.csv)
# -----------------------------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb_otbr.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_4mb_otbr.csv"

# -----------------------------------------------------------------------------
# Wi-Fi backbone — CHANGE THESE. example_connect() (used by the border-router
# auto-init path) reads these; set your AP's SSID/PSK.
# -----------------------------------------------------------------------------
CONFIG_EXAMPLE_CONNECT_WIFI=y
CONFIG_EXAMPLE_CONNECT_IPV6=y
CONFIG_EXAMPLE_WIFI_SSID="YOUR_WIFI_SSID"
CONFIG_EXAMPLE_WIFI_PASSWORD="YOUR_WIFI_PASSWORD"

# Never stop trying to reconnect. THIS IS LOAD-BEARING for an always-on border
# router — with the example's default of 6, the BR permanently drops off the LAN.
#
# protocol_examples_common's example_handler_on_wifi_disconnect() increments a
# retry counter on every WIFI_EVENT_STA_DISCONNECTED and, once it exceeds this
# value, logs "WiFi Connect failed N times, stop reconnect." and calls
# example_wifi_sta_do_disconnect() — which UNREGISTERS the disconnect handler.
# Nothing ever calls esp_wifi_connect() again: the chip keeps running and stays
# attached to Thread, but is unreachable over Wi-Fi (no REST API, no mDNS, HA
# marks the OTBR dead) until a manual power cycle. It is a permanent latch, not
# a transient — and app_main has no Wi-Fi supervision to undo it.
#
# The counter is only reset in the IPv4 GOT_IP handler, so it takes 7 disconnects
# with no successful DHCP lease in between. Two ways that happens here:
#   * AP briefly gone (router reboot / firmware update / channel change) — the 6
#     retries are spent in well under a minute, long before the AP returns.
#   * Roaming in a mesh (Fritz!Box + repeaters): the counter is incremented
#     BEFORE the WIFI_REASON_ROAMING early-return, and a roam that keeps the
#     same lease produces no GOT_IP to reset it — so roams accumulate forever.
#
# Upstream fixed this AFTER the v5.5 branch: master guards the check with
# "CONFIG_EXAMPLE_WIFI_CONN_MAX_RETRY >= 0" and documents -1 as infinite.
# DO NOT set -1 on v5.5.x — that guard does not exist here, so "s_retry_num > -1"
# is true on the very FIRST disconnect and the BR gives up immediately. Instead
# pin INT_MAX, which the v5.5.x comparison can never exceed.
CONFIG_EXAMPLE_WIFI_CONN_MAX_RETRY=2147483647

# -----------------------------------------------------------------------------
# OpenThread — single-chip C6: native 802.15.4 radio + Wi-Fi/15.4 SW coexistence
# -----------------------------------------------------------------------------
# Override the v5.5 example default (CONFIG_OPENTHREAD_RADIO_SPINEL_UART=y).
CONFIG_OPENTHREAD_RADIO_NATIVE=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# Auto-start on boot. In v5.5 these are split into two example-level symbols and
# BOTH default to 'n', so both must be set:
#   *_BORDER_ROUTER_AUTO_START -> example_connect (Wi-Fi) + border-router init
#                                 + the explicit esp_coex_wifi_i154_enable()
#   *_NETWORK_AUTO_START       -> create/join the Thread network
# (These replace the v5.4.x CONFIG_OPENTHREAD_BR_AUTO_START symbol.)
CONFIG_OPENTHREAD_BORDER_ROUTER_AUTO_START=y
CONFIG_OPENTHREAD_NETWORK_AUTO_START=y

# Thread table sizes. The stock defaults are sized for a small test mesh and
# silently cap a long-running home BR:
#   *_MLE_MAX_CHILDREN (default 10): when the child table is full, OpenThread
#     ignores MLE Parent Requests outright (mle_ftd.cpp, GetNewChild() -> NoBufs).
#     Sleepy Matter devices accumulate on the BR over weeks of uptime, so a new
#     joiner that only hears the BR can't attach and pairing hangs at
#     "Connecting to Thread network" — until a BR reboot scatters the children
#     onto other routers and frees slots. Check GET /diag (Children/ChildrenMax).
#   IEEE802154_PENDING_TABLE_SIZE (default 20): radio frame-pending entries for
#     sleepy children — keep it >= MAX_CHILDREN.
#   *_TMF_ADDR_CACHE_ENTRIES (default 20): EID->RLOC16 cache the BR uses to
#     forward LAN traffic (HA/Matter) to Thread devices; headroom for the mesh to grow.
# RAM cost is a few KB of .bss in total.
CONFIG_OPENTHREAD_MLE_MAX_CHILDREN=32
CONFIG_IEEE802154_PENDING_TABLE_SIZE=32
CONFIG_OPENTHREAD_TMF_ADDR_CACHE_ENTRIES=32

# The border-router auto-init path hard-#errors if the CLI 'wifi' command is on,
# and we drive Wi-Fi via example_connect instead — keep it off.
CONFIG_OPENTHREAD_CLI_WIFI=n

# NOTE: the OpenThread CLI stays on its default UART0 console. Routing it to the
# USB-Serial-JTAG (to reach it over the XIAO's USB-C port) makes the ot_cli task
# busy-spin and trips the task watchdog, so we don't.

# -----------------------------------------------------------------------------
# mDNS — the border router mirrors Thread/Matter SRP services onto the Wi-Fi LAN
# via mDNS. The IDF default cap (CONFIG_MDNS_MAX_SERVICES=10) is too low for a
# Matter mesh: once hit, extra services fail to advertise (the responder logs
# "Cannot add more services" and the SRP server returns a fail response), which
# makes commissioning of the NEXT device hang at "Connecting to Thread network".
# Budget generously: every device costs one slot PER FABRIC it's joined to
# (HA + Apple/Google = 2-3 each), plus one _matterc._udp slot per open
# commissioning window, plus _meshcop._udp — 9 devices already used 21 slots.
# The cap is only a linked-list length check: raising it costs no RAM until
# slots are actually used (~0.5 KB heap per registered service), and no
# flash-partition space. Watch GET /heap (MinFreeHeap) as the mesh grows.
# -----------------------------------------------------------------------------
CONFIG_MDNS_MAX_SERVICES=128

# -----------------------------------------------------------------------------
# Thread network credentials — CHANGE THESE (security) [optional]
# -----------------------------------------------------------------------------
# A previously-formed dataset persists in NVS and is reused on boot; the options
# below only take effect on a FRESH NVS (idf.py erase-flash). The stock
# OpenThread example credentials are PUBLICLY KNOWN, so for a brand-new network
# generate your own:
#     openssl rand -hex 16    # network key and PSKc (16 bytes each)
#     openssl rand -hex 8     # extended PAN ID (8 bytes)
# then set the matching CONFIG_OPENTHREAD_NETWORK_* options (confirm the exact
# symbol names for your IDF version via 'idf.py menuconfig').

# -----------------------------------------------------------------------------
# Compiler optimisations — needed to fit in 4 MB
# -----------------------------------------------------------------------------
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_COMPILER_SAVE_RESTORE_LIBCALLS=y

# -----------------------------------------------------------------------------
# Logging — INFO app logs, WARN for OpenThread to keep it quiet
# -----------------------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_OPENTHREAD_LOG_LEVEL_DYNAMIC=n
CONFIG_OPENTHREAD_LOG_LEVEL_WARN=y

# Nano-printf keeps printf small. On v5.5 the symbol is CONFIG_LIBC_NEWLIB_NANO_FORMAT
# (it was CONFIG_NEWLIB_NANO_FORMAT on v5.4.x — the wrong name silently no-ops).
CONFIG_LIBC_NEWLIB_NANO_FORMAT=y
